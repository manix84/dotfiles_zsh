function _shell_function_help() {
	case "$1" in
		mkd) cat <<'EOF'
Usage: mkd DIRECTORY...
Create the supplied directories with parent directories as needed, then enter
the final argument. Example: mkd projects/new-app
EOF
		;;
		fs) cat <<'EOF'
Usage: fs [PATH...]
Show human-readable disk usage for the supplied files or directories. With no
arguments, show the size of entries in the current directory. Requires du.
EOF
		;;
		diff) cat <<'EOF'
Usage: diff [GIT-DIFF-OPTIONS] PATH PATH
Compare two paths outside a repository using Git's color-word diff renderer.
This function is available only when Git is installed.
EOF
		;;
		cdl) cat <<'EOF'
Usage: cdl DIRECTORY
Change to DIRECTORY and list all entries there in long, human-readable form.
EOF
		;;
		dataurl) cat <<'EOF'
Usage: dataurl FILE
Print FILE as a base64 data URL, detecting its MIME type with file. Text files
are marked as UTF-8. Requires file and OpenSSL.
EOF
		;;
		gz) cat <<'EOF'
Usage: gz FILE
Print the original and gzip-compressed byte counts for FILE without modifying
it. Requires gzip.
EOF
		;;
		httpcompression) cat <<'EOF'
Usage: httpcompression URL
Request URL with compression enabled and report its Content-Encoding response
header. Requires curl and network access.
EOF
		;;
		json) cat <<'EOF'
Usage: json [JSON]
Pretty-print and syntax-highlight a JSON argument, or read JSON from stdin when
piped. Requires Python's json.tool and Pygments' pygmentize command.
EOF
		;;
		digga) cat <<'EOF'
Usage: digga DOMAIN
Show multiline DNS ANY-record answers for DOMAIN. Requires dig and network
access; some DNS servers restrict ANY queries.
EOF
		;;
		escape) cat <<'EOF'
Usage: escape TEXT
Encode the bytes of TEXT as uppercase \xNN escape sequences. Requires xxd.
EOF
		;;
		unidecode) cat <<'EOF'
Usage: unidecode ESCAPED_TEXT
Decode Perl-style Unicode escape sequences and print UTF-8 output. Input is
interpreted as a Perl string expression; use only with trusted text.
EOF
		;;
		codepoint) cat <<'EOF'
Usage: codepoint CHARACTER
Print the Unicode code point of the first supplied character in U+NNNN form.
Requires Perl with UTF-8 support.
EOF
		;;
		grok) cat <<'EOF'
Usage: grok SEARCH_TEXT [PATH]
Recursively list files beneath PATH (default: current directory) containing
SEARCH_TEXT, ignoring unreadable-file diagnostics. Requires grep.
EOF
		;;
		killport) cat <<'EOF'
Usage: killport PORT
Find processes listening on PORT with lsof and terminate them with SIGKILL.
Warning: unsaved process data may be lost; requires lsof and kill.
EOF
		;;
	esac
}

# Create a new directory and enter it
function mkd() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help mkd; return; fi
	mkdir -p "$@" && cd "$@"
}

# Determine size of a file or total size of a directory
function fs() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help fs; return; fi
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh
	else
		local arg=-sh
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@"
	else
		du $arg .[^.]* *
	fi
}

# Use Git’s colored diff when available
hash git &>/dev/null
if [ $? -eq 0 ]; then
	function diff() {
		if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help diff; return; fi
		git diff --no-index --color-words "$@"
	}
fi

# CD to a directory and list it.
function cdl() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help cdl; return; fi
    cd $1 && ls -lah
}

# Create a data URL from a file
function dataurl() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help dataurl; return; fi
	local mimeType=$(file -b --mime-type "$1")
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf-8"
	fi
	echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')"
}

# Get gzipped file size
function gz() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help gz; return; fi
	echo "orig size (bytes): "
	cat "$1" | wc -c
	echo "gzipped size (bytes): "
	gzip -c "$1" | wc -c
}

# Test if HTTP compression (RFC 2616 + SDCH) is enabled for a given URL.
# Send a fake UA string for sites that sniff it instead of using the Accept-Encoding header. (Looking at you, ajax.googleapis.com!)
function httpcompression() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help httpcompression; return; fi
	encoding="$(curl -LIs -H 'User-Agent: Mozilla/5 Gecko' -H 'Accept-Encoding: gzip,deflate,compress,sdch' "$1" | grep '^Content-Encoding:')" && echo "$1 is encoded using ${encoding#* }" || echo "$1 is not using any encoding"
}

# Syntax-highlight JSON strings or files
# Usage: `json '{"foo":42}'` or `echo '{"foo":42}' | json`
function json() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help json; return; fi
	if [ -t 0 ]; then # argument
		python -mjson.tool <<< "$*" | pygmentize -l javascript
	else # pipe
		python -mjson.tool | pygmentize -l javascript
	fi
}

# All the dig info
function digga() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help digga; return; fi
	dig +nocmd "$1" any +multiline +noall +answer
}

# Escape UTF-8 characters into their 3-byte format
function escape() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help escape; return; fi
	printf "\\\x%s" $(printf "$@" | xxd -p -c1 -u)
	echo # newline
}

# Decode \x{ABCD}-style Unicode escape sequences
function unidecode() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help unidecode; return; fi
	perl -e "binmode(STDOUT, ':utf8'); print \"$@\""
	echo # newline
}

# Get a character’s Unicode code point
function codepoint() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help codepoint; return; fi
	perl -e "use utf8; print sprintf('U+%04X', ord(\"$@\"))"
	echo # newline
}

# Search file(s) for keywords.
function grok() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help grok; return; fi
    # Display usage if no parameters given
    if [[ -z "$@" ]]; then
        echo -e " ${0##*/} <string> <file/path> - search recursively for keyword in files"
        exit
    fi

    if [ -z "$2" ]; then
        loc=$(pwd)
    else
        loc="$2"
    fi

    echo " Searching..."
    grep -ilr "$@" "$loc" 2>&1 | grep -v "No such" | grep -v "Permission denied" | sed "s:^\.::g" | sed "s:$(pwd)::g" | sort | uniq
}

# Kill any program that's running on a specified port
function killport() {
	if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then _shell_function_help killport; return; fi
  if [ -z "${1:-}" ]; then
    _shell_function_help killport
    return 1
  fi

  PORT=$1
  PIDS=$(lsof -ti :$PORT)

  if [ -z "$PIDS" ]; then
    echo "No process is using port $PORT"
  else
    echo "Killing process(es) $PIDS on port $PORT"
    # Safely handle multiple PIDs by splitting on spaces or newlines
    echo "$PIDS" | xargs kill -9
  fi
}

# Retry an SSH connection until it succeeds or the user presses Ctrl-C.
function sshwait() {
	if (( $# == 0 )) || [[ "$1" == "-h" || "$1" == "--help" ]]; then
		cat <<'EOF'
Usage: sshwait [SSH_OPTIONS] DESTINATION [COMMAND]

Repeatedly attempts an SSH connection, waiting 3 seconds after each
failure. Once connected, it behaves like a normal SSH session and exits
when that session ends.

Examples:
  sshwait rob@server.local
  sshwait -p 2222 user@example.com
  sshwait server.example.com uptime

Press Ctrl-C to stop retrying.
EOF
		return
	fi

	local start_time=$SECONDS

	while ! command ssh "$@"; do
		local elapsed=$(( SECONDS - start_time ))
		local minutes=$(( elapsed / 60 ))
		local seconds=$(( elapsed % 60 ))

		printf 'SSH connection failed; retrying in 3 seconds... (elapsed: %02d:%02d)\n' \
			"$minutes" "$seconds"
		sleep 3
	done
}
