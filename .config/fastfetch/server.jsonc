{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Server profile: remote sessions and headless Linux systems.
  "logo": {
    "type": "small"
  },

  "modules": [
    // Identity
    "title",
    "separator",

    "os",
    "host",
    "kernel",
    "uptime",
    "initsystem",
    "packages",
    "shell",
    "terminal",

    "break",

    // Compute health
    "cpu",
    "cpuusage",
    "loadavg",
    "memory",
    "swap",
    "processes",

    "break",

    // Storage
    "disk",

    "break",

    // Network
    "localip",

    "break",
    "colors"
  ]
}
