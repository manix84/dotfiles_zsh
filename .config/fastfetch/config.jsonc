{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Workstation profile: local laptops and desktop computers.
  "modules": [
    // Identity
    "title",
    "separator",

    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "terminalfont",

    "break",

    // Graphical session
    "display",
    "de",
    "wm",
    "theme",

    "break",

    // Performance
    "cpu",
    "gpu",
    "memory",
    "swap",
    "loadavg",
    "processes",

    "break",

    // Storage
    "disk",

    "break",

    // Network, power, and locale
    "localip",
    "wifi",
    "battery",
    "poweradapter",
    "locale",

    "break",
    "colors",
  ],
}
